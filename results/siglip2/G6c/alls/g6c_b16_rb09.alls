model_optimization_flavor(optimization_level=1, compression_level=0)
pre_quantization_optimization(layer_norm_decomposition, equalization=disabled, bit_decomposition_mode=uniform_precision)
model_optimization_config(calibration, calibset_size=256)
quantization_param([conv1], precision_mode=a16_w16)
quantization_param([ew_add1, ew_add2, ew_add3, ew_add4, ew_add5, ew_add6, ew_add7, ew_add8, ew_add9, ew_add10, ew_add11, ew_add14, ew_add16, ew_add19, ew_add21, ew_add24, ew_add26, ew_add29, ew_add31, ew_add36, ew_add38, ew_add43, ew_add45, ew_add50, ew_add52, ew_add57], precision_mode=a16_w16)
quantization_param([conv4, conv5, conv24, conv25, conv41], precision_mode=a16_w16)

resources_param(max_compute_utilization=0.9, max_control_utilization=0.95, max_memory_utilization=0.75)
